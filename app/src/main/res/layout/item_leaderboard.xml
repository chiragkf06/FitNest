<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutLeaderboardItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_pill_white"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="16dp"
    android:paddingVertical="12dp">

    <!-- Rank Number -->
    <TextView
        android:id="@+id/tvRankNumber"
        android:layout_width="28dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="4"
        android:textColor="@color/text_secondary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <!-- Avatar circle -->
    <FrameLayout
        android:id="@+id/layoutAvatar"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_marginStart="10dp"
        android:background="@drawable/bg_circle_avatar">

        <TextView
            android:id="@+id/tvAvatarInitial"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="N"
            android:textColor="@color/primary"
            android:textSize="15sp"
            android:textStyle="bold" />
    </FrameLayout>

    <!-- Name -->
    <TextView
        android:id="@+id/tvLeaderboardName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:text="Neha"
        android:textColor="@color/text_main"
        android:textSize="15sp"
        android:textStyle="bold" />

    <!-- XP Badge -->
    <TextView
        android:id="@+id/tvLeaderboardXP"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="1100 XP"
        android:textColor="@color/primary"
        android:textSize="13sp"
        android:textStyle="bold" />

</LinearLayout>
